{
    "name": "janickiy/html",
    "description": "HTML and Form Builders for the Laravel Framework",
    "license": "MIT",
    "homepage": "",
    "support": {
        "issues": "https://github.com/janickiy/html/issues",
        "source": "https://github.com/janickiy/html"
    },
    "authors": [
        {
            "name": "Alexander Yanitskiy",
            "email": "janickiy@mail.ru"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/session": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "mockery/mockery": "~1.0",
        "phpunit/phpunit": "~8.5|^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "Collective\\Html\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "6.x-dev"
        },
        "laravel": {
            "providers": [
                "Collective\\Html\\HtmlServiceProvider"
            ],
            "aliases": {
                "Form": "Collective\\Html\\FormFacade",
                "Html": "Collective\\Html\\HtmlFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}